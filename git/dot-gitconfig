[core]
	excludesfile = ~/.gitignore_global
	editor = vim
[alias]
	# Branch
	bdl  = branch -d
	bdf  = branch -D
	dbr  = push origin --delete
	# Commit
	ca   = commit --amend
	# Push/pull
	gpu  = push
	plom = pull origin main
	puf  = push --force-with-lease
	# Rebase
	ri   = rebase -i
	rc   = rebase --continue
	ra   = rebase --abort
	rh   = reset --hard
	# Cherry-pick
	pick = cherry-pick
	# Stash
	st   = stash
	stp  = stash pop
	# Clean
	wipe = clean -fd
	# Log
	ll  = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	sla = log --oneline --decorate --graph --all
[push]
	default = upstream
	autoSetupRemote = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[commit]
	template = ~/.gitmessage
