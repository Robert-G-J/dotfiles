"============================================================
"                   ~Appearance~
"============================================================

syntax enable

" Colourschemes to use in each mode — change these to swap themes
let g:theme_light = 'hybrid'
let g:theme_dark  = 'hybrid'

" Reads macOS system appearance and applies the matching colourscheme.
" Called at startup and whenever vim regains focus, so the theme stays
" in sync after the machine sleeps or the user switches appearance.
function! s:ApplySystemTheme() abort
  if system('defaults read -g AppleInterfaceStyle 2>/dev/null') =~? 'dark'
    set background=dark
    execute 'colorscheme ' . g:theme_dark
  else
    set background=light
    execute 'colorscheme ' . g:theme_light
  endif
endfunction

autocmd VimEnter,FocusGained * call s:ApplySystemTheme()
call s:ApplySystemTheme()

"============================================================
"                   ~General Settings~
"============================================================

set mouse=n               " mouse scroll in normal mode
set number                " show line numbers
set laststatus=2          " always show statusline
set nobackup              " don't create backup files
set nowritebackup
set noswapfile
set nohlsearch            " don't persist search highlight
set incsearch             " highlight as you type
set ignorecase            " case-insensitive search
set pastetoggle=<F9>      " toggle paste mode (disables auto-indent)
set ruler
set relativenumber
set autoindent
set tabstop=2
set scrolloff=4
set softtabstop=2
set shiftwidth=2
set shiftround
set splitright
set splitbelow
set expandtab
set secure
set smarttab
set wrap

" Use system clipboard
if has('unnamedplus')
  set clipboard=unnamed,unnamedplus
endif

"==========================================================================
" CoC — Language Server Protocol (LSP) client
"
" CoC connects Vim to language servers (tsserver, eslint, prettier, yaml-ls)
" which provide completions, go-to-definition, hover docs, diagnostics, code
" actions, and formatting — similar to what you'd get in VS Code.
"
" How it works:
"   When you open a JS/TS file, CoC starts the tsserver language server in
"   the background. That server analyses your code and sends back errors,
"   type info, and completions. CoC surfaces these in Vim.
"
" Key mappings:
"   gd            → go to definition
"   K             → show docs / type info for symbol under cursor
"   [g / ]g       → jump to previous / next diagnostic (error or warning)
"   <Space>rn     → rename symbol under cursor across the project
"   <Space>fd     → format file with prettier
"   <Space>ac     → code action at cursor (e.g. add missing import)
"   <Space>qf     → quick fix on the current line
"   <Space>ld     → list all diagnostics in a searchable window
"   <Space>le     → manage installed CoC extensions
"   <Space>lc     → list available CoC commands
"   <Space>lr     → resume the last CoC list
"==========================================================================

set cmdheight=2           " extra space for CoC messages
set hidden                " allow switching buffers without saving
set shortmess+=c          " suppress ins-completion-menu messages
set updatetime=300        " faster diagnostics (default 4000ms feels slow)

" Point coc.nvim at the real node binary via NVM — shell functions aren't visible to vim
let g:coc_node_path = trim(system('source ' . $HOMEBREW_PREFIX . '/opt/nvm/nvm.sh && nvm which default 2>/dev/null'))
let g:coc_npm_path = fnamemodify(g:coc_node_path, ':h') . '/npm'

" Always show the sign column so diagnostics don't shift the text
if has("patch-8.1.1564")
  set signcolumn=number
else
  set signcolumn=yes
endif

" Trigger completion manually with <c-space>
inoremap <silent><expr> <c-space> coc#refresh()

" <cr> confirms a completion selection; otherwise inserts a newline
if exists('*complete_info')
  inoremap <expr> <cr> complete_info()["selected"] != "-1" ? "\<C-y>" : "\<C-g>u\<CR>"
else
  inoremap <expr> <cr> pumvisible() ? "\<C-y>" : "\<C-g>u\<CR>"
endif

" Navigate diagnostics (errors and warnings reported by the language server)
nnoremap <silent> [g <Plug>(coc-diagnostic-prev)
nnoremap <silent> ]g <Plug>(coc-diagnostic-next)

" Go to definition
nnoremap <silent> gd <Plug>(coc-definition)
" nnoremap <silent> gy <Plug>(coc-type-definition)
" nnoremap <silent> gi <Plug>(coc-implementation)
" nnoremap <silent> gr <Plug>(coc-references)

" Show documentation or type info for the symbol under the cursor
nnoremap <silent> K :call <SID>show_documentation()<CR>

function! s:show_documentation()
  if (index(['vim','help'], &filetype) >= 0)
    execute 'h '.expand('<cword>')
  else
    call CocAction('doHover')
  endif
endfunction

" Highlight all references to the symbol under the cursor when idle
autocmd CursorHold * silent call CocActionAsync('highlight')

" Allow // comments in JSON files (used by CoC and tsconfig)
autocmd FileType json syntax match Comment +\/\/.\+$+

" Rename the symbol under the cursor across the project
nnoremap <Space>rn <Plug>(coc-rename)

augroup mygroup
  autocmd!
  autocmd FileType typescript,json setl formatexpr=CocAction('formatSelected')
  autocmd User CocJumpPlaceholder call CocActionAsync('showSignatureHelp')
augroup end

" Code actions — e.g. add missing import, extract to variable
xnoremap <Space>a  <Plug>(coc-codeaction-selected)
nnoremap <Space>a  <Plug>(coc-codeaction-selected)
nnoremap <Space>ac <Plug>(coc-codeaction)

" Quick fix the problem on the current line
nnoremap <Space>qf <Plug>(coc-fix-current)

" Format the current file with prettier
nnoremap <Space>fd :CocCommand prettier.formatFile<cr>

" Text objects for functions and classes (requires LSP documentSymbol support)
xnoremap if <Plug>(coc-funcobj-i)
onoremap if <Plug>(coc-funcobj-i)
xnoremap af <Plug>(coc-funcobj-a)
onoremap af <Plug>(coc-funcobj-a)
xnoremap ic <Plug>(coc-classobj-i)
onoremap ic <Plug>(coc-classobj-i)
xnoremap ac <Plug>(coc-classobj-a)
onoremap ac <Plug>(coc-classobj-a)

" Commands
command! -nargs=0 Format :call CocAction('format')
command! -nargs=? Fold   :call CocAction('fold', <f-args>)
command! -nargs=0 OR     :call CocAction('runCommand', 'editor.action.organizeImport')

" CoC status in the statusline
set statusline^=%{coc#status()}%{get(b:,'coc_current_function','')}

" CoC lists — all under <Space>l to avoid conflicts
nnoremap <silent><nowait> <Space>ld :<C-u>CocList diagnostics<cr>
nnoremap <silent><nowait> <Space>le :<C-u>CocList extensions<cr>
nnoremap <silent><nowait> <Space>lc :<C-u>CocList commands<cr>
nnoremap <silent><nowait> <Space>lj :<C-u>CocNext<CR>
nnoremap <silent><nowait> <Space>lk :<C-u>CocPrev<CR>
nnoremap <silent><nowait> <Space>lr :<C-u>CocListResume<CR>

" Load CoC extensions based on what's installed in the current project
if isdirectory('./node_modules')
  let g:coc_global_extensions = [
      \ 'coc-tsserver',
      \ 'coc-yaml'
    \]
  if isdirectory('./node_modules/prettier')
    let g:coc_global_extensions += ['coc-prettier']
  endif
  if isdirectory('./node_modules/eslint')
    let g:coc_global_extensions += ['coc-eslint']
  endif
endif
