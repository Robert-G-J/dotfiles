"============================================================
"                     ~vimrc~
"============================================================
"
" Author:       Robert Jones [http://github.com/robert-g-j]
" Source:       https://github.com/robert-g-j/dotfiles
"
"============================================================

set nocompatible          " must be first — disables Vi compatibility

filetype plugin indent on " enable filetype detection, plugins, and indentation
runtime macros/matchit.vim " jump between matching html/xml tags with %

au BufNewFile,BufRead *.ejs set filetype=html " html syntax highlighting for EJS

"============================================================
"                     ~Mappings~
"============================================================

" To reindent after pasting: == (current line), =ip (paragraph), =3j (3 lines down)

" Easy access to the start of the line
nnoremap 0 ^

" Prevent incomplete mapping messages
nnoremap <Space> <Nop>
xnoremap <Space> <Nop>

" Edit and reload vimrc
nnoremap <Space>vi :tabedit $MYVIMRC<cr>
nnoremap <Space>so :source $MYVIMRC<cr>

" File tree
nnoremap <Space>nt :NERDTree<cr>
nnoremap <Space>nf :NERDTreeFind<cr>

" Search
" <C-p>     → fzf: find files by name
" <Space>f  → fzf ripgrep: search text across files
nnoremap <silent> <C-p> :Files<cr>
nnoremap <silent> <Space>fi :Rg<cr>
function! RipgrepFzf(query, fullscreen)
  let fmt = 'rg --column --line-number --no-heading --color=always --smart-case -- %s || true'
  let spec = fzf#vim#with_preview(
    \ {'options': ['--disabled', '--query', a:query, '--delimiter', ':', '--nth', '4..',
    \              '--bind', 'change:reload:'.printf(fmt, '{q}')]},
    \ 'right:50%')
  call fzf#vim#grep(printf(fmt, shellescape(a:query)), 1, spec, a:fullscreen)
endfunction
command! -bang -nargs=* Rg call RipgrepFzf(<q-args>, <bang>0)

" Paste last yank (register 0, unaffected by deletes)
nnoremap <Space>p "0P

" Move by visible lines when text is wrapped
nnoremap j gj
nnoremap k gk

" Escape from insert mode
inoremap jj <Esc>

" Make hash accessible from key
inoremap £ #
nnoremap £ #
vnoremap £ #

" Save on leaving insert mode
autocmd InsertLeave * silent! update

